-- LOWKEY HUB - WEAREDEVS VERSION
-- ==========================================
local CORRECT_KEY = "LowkeyTheGoat"

local P = game:GetService("Players")
local SG = game:GetService("StarterGui")
local p = P.LocalPlayer or P.PlayerAdded:Wait()

local playerGui = p:WaitForChild("PlayerGui", 10)
if not playerGui then return end

local function notify(title, text)
	pcall(function()
		SG:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 3,
		})
	end)
end

if getgenv().LowkeyHubLoaded then
	pcall(function()
		p:Kick("\n[Lowkey Hub] Security Violation:\nYou attempted to execute the script more than once!")
	end)
	return
end
getgenv().LowkeyHubLoaded = true

local function launchLowkeyHub()
	local R = game:GetService("RunService")
	local U = game:GetService("UserInputService")

	local records = {}
	local recording = false
	local replaying = false
	local infiniteJumpEnabled = false
	local current = nil

	local playbackSpeeds = {1, 1.5, 2, 0.5}
	local currentSpeedIndex = 1
	local playbackSpeed = playbackSpeeds[currentSpeedIndex]

	local C_MAIN_BG = Color3.fromRGB(10, 15, 26)
	local C_HEADER_BG = Color3.fromRGB(15, 25, 42)
	local C_BTN_BG = Color3.fromRGB(16, 32, 58)
	local C_ACCENT_CYAN = Color3.fromRGB(0, 225, 255)
	local C_TEXT_WHITE = Color3.fromRGB(240, 250, 255)

	local g = Instance.new("ScreenGui")
	g.Name = "LowkeyHub"
	g.ResetOnSpawn = false
	g.Parent = playerGui

	local open = Instance.new("TextButton")
	open.Size = UDim2.fromOffset(35, 22)
	open.Position = UDim2.new(0, 15, 0.78, 0)
	open.Text = "☰"
	open.TextScaled = true
	open.TextColor3 = C_ACCENT_CYAN
	open.BackgroundColor3 = C_MAIN_BG
	open.BorderColor3 = C_ACCENT_CYAN
	open.Parent = g

	local m = Instance.new("Frame")
	m.Size = UDim2.fromOffset(140, 295)
	m.Position = UDim2.new(0, 75, 0.45, 0)
	m.BackgroundColor3 = C_MAIN_BG
	m.BorderColor3 = C_ACCENT_CYAN
	m.Active = true
	m.Parent = g

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 20)
	title.Position = UDim2.new(0, 0, 0, 4)
	title.Text = "LOWKEY HUB"
	title.TextScaled = true
	title.TextColor3 = C_ACCENT_CYAN
	title.Font = Enum.Font.GothamBold
	title.BackgroundTransparency = 1
	title.Parent = m

	local cooldownLabel = Instance.new("TextLabel")
	cooldownLabel.Size = UDim2.new(1, -8, 0, 18)
	cooldownLabel.Position = UDim2.new(0, 4, 0, 272)
	cooldownLabel.Text = "Status: Unlocked"
	cooldownLabel.TextScaled = true
	cooldownLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
	cooldownLabel.Font = Enum.Font.GothamBold
	cooldownLabel.BackgroundTransparency = 1
	cooldownLabel.Parent = m

	local function B(t, y)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, -8, 0, 23)
		b.Position = UDim2.new(0, 4, 0, y)
		b.Text = t
		b.TextScaled = true
		b.TextColor3 = C_TEXT_WHITE
		b.BackgroundColor3 = C_BTN_BG
		b.BorderColor3 = C_ACCENT_CYAN
		b.Font = Enum.Font.GothamMedium
		b.Parent = m
		return b
	end

	local rec = B("🔴 Record", 28)
	local stop = B("⏹ Stop", 53)
	local replay = B("▶ Replay", 78)
	local randomReplay = B("🔀 Random", 103)
	local speedBtn = B("⚡ Speed: 1x", 128)
	local infJumpBtn = B("🦘 Inf Jump: OFF", 153)
	local clear = B("🗑 Clear All", 178)
	local close = B("✕ Close", 203)

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -8, 0, 35)
	list.Position = UDim2.new(0, 4, 0, 230)
	list.BackgroundColor3 = C_HEADER_BG
	list.BorderColor3 = C_ACCENT_CYAN
	list.ScrollBarThickness = 2
	list.Parent = m

	speedBtn.MouseButton1Click:Connect(function()
		currentSpeedIndex = (currentSpeedIndex % #playbackSpeeds) + 1
		playbackSpeed = playbackSpeeds[currentSpeedIndex]
		speedBtn.Text = "⚡ Speed: " .. playbackSpeed .. "x"
	end)

	U.JumpRequest:Connect(function()
		if infiniteJumpEnabled then
			local c = p.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end)

	infJumpBtn.MouseButton1Click:Connect(function()
		infiniteJumpEnabled = not infiniteJumpEnabled
		infJumpBtn.Text = infiniteJumpEnabled and "🦘 Inf Jump: ON" or "🦘 Inf Jump: OFF"
	end)

	open.MouseButton1Click:Connect(function() m.Visible = not m.Visible end)
	close.MouseButton1Click:Connect(function() m.Visible = false end)
end

if getgenv().LowkeyHubVerified then
	notify("LowkeyHub", "Session resumed!")
	launchLowkeyHub()
	return
end

local keyGui = Instance.new("ScreenGui")
keyGui.Name = "LowkeyHub_KeySystem"
keyGui.ResetOnSpawn = false
keyGui.Parent = playerGui

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.fromOffset(280, 150)
mainFrame.Position = UDim2.new(0.5, -140, 0.5, -75)
mainFrame.BackgroundColor3 = Color3.fromRGB(10, 15, 26)
mainFrame.BorderColor3 = Color3.fromRGB(0, 225, 255)
mainFrame.Parent = keyGui

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 30)
titleLabel.Position = UDim2.new(0, 0, 0, 10)
titleLabel.Text = "LOWKEY HUB - KEY SYSTEM"
titleLabel.TextColor3 = Color3.fromRGB(0, 225, 255)
titleLabel.TextScaled = true
titleLabel.Font = Enum.Font.GothamBold
titleLabel.BackgroundTransparency = 1
titleLabel.Parent = mainFrame

local textBox = Instance.new("TextBox")
textBox.Size = UDim2.new(1, -30, 0, 35)
textBox.Position = UDim2.new(0, 15, 0, 50)
textBox.PlaceholderText = "Enter Key Here..."
textBox.Text = ""
textBox.TextScaled = true
textBox.TextColor3 = Color3.fromRGB(240, 250, 255)
textBox.BackgroundColor3 = Color3.fromRGB(15, 25, 42)
textBox.BorderColor3 = Color3.fromRGB(0, 225, 255)
textBox.Font = Enum.Font.Gotham
textBox.Parent = mainFrame

local submitBtn = Instance.new("TextButton")
submitBtn.Size = UDim2.new(1, -30, 0, 32)
submitBtn.Position = UDim2.new(0, 15, 0, 98)
submitBtn.Text = "SUBMIT KEY"
submitBtn.TextScaled = true
submitBtn.TextColor3 = Color3.fromRGB(240, 250, 255)
submitBtn.BackgroundColor3 = Color3.fromRGB(16, 32, 58)
submitBtn.BorderColor3 = Color3.fromRGB(0, 225, 255)
submitBtn.Font = Enum.Font.GothamBold
submitBtn.Parent = mainFrame

submitBtn.MouseButton1Click:Connect(function()
	if textBox.Text == CORRECT_KEY then
		getgenv().LowkeyHubVerified = true
		notify("LowkeyHub", "Key Correct! Hub Unlocked.")
		keyGui:Destroy()
		launchLowkeyHub()
	else
		notify("LowkeyHub", "Incorrect Key! Try again.")
	end
end)
